# Supabase Configuration (Client Public Keys - ONLY URL & Anon Key with strict RLS)
# أضف القيم من لوحة تحكم مشروعك في Supabase (Settings -> API) داخل ملف .env محلي (لا ترفع .env للمستودع)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Only Secret (NEVER prefix with VITE_ and NEVER expose in frontend code!)
# يستخدم فقط في الخادم الخلفي عند الحاجة إلى مهام إدارية موثقة
SUPABASE_SERVICE_ROLE_KEY=

# Optional Weather / Server AI APIs
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
GEMINI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
